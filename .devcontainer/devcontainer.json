{
	"name": "openECOE_API_dev",
	"dockerComposeFile": [
		"../.docker/docker-compose.persistence.yml",
		"docker-compose.devcontainer.yml"
	],
	"service": "workspace",
	"workspaceFolder": "/workspaces/openECOE-API",
	"postCreateCommand": "bash -lc 'poetry config virtualenvs.in-project true --local && poetry install --with dev,api,chrono'",

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	// "features": {},

	// 👇 Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// 👇 Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "",

	// 👇 Configure tool-specific properties.
	"customizations": {
        "vscode": {
            "extensions":["ms-python.python", "njpwerner.autodocstring"],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.terminal.activateEnvironment": true
			}
            }
		},
	"features": {},
	"remoteEnv": {
		"OPENECOE_DB_HOST": "db",
		"OPENECOE_DB_PORT": "3306",
		"OPENECOE_DB_USER": "openecoe",
		"OPENECOE_DB_PASSWORD": "openecoe",
		"OPENECOE_DB_NAME": "openECOE_dev",
		"OPENECOE_REDIS_HOST": "redis",
		"OPENECOE_REDIS_PORT": "6379",
		"OPENECOE_REDIS_DB": "0"
	}
	// 👇 Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
